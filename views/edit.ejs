<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit your chat</title>
</head>
<body>
    <p>Edit your chat <%= chat.id%></p>
    <p>This Chat was sent from <b><%=chat.from%></b> to <b><%=chat.to%></b></p>

    <form> 
        <textarea rows="8" cols="25"><%= chat.msg%></textarea>
        <br>
        <button>edit</button>
    </form>
    
</body>
</html>